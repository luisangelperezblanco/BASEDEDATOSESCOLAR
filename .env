# Base de datos SQLite (archivo local). Cambia la ruta si lo necesitas.
DATABASE_URL="file:./dev.db"

# Secreto para firmar las sesiones (JWT). Cambialo en produccion por uno largo y aleatorio.
AUTH_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio-en-produccion-1234567890"

# URL base de la app (usada para construir enlaces de recuperacion).
APP_URL="http://localhost:3000"
